# Skills Agent 环境变量配置
# 复制此文件为 .env 并填入你的配置

# 默认：DeepSeek（OpenAI 兼容协议）
# API Key 申请地址：https://platform.deepseek.com/api_keys
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-flash
MODEL_API_KEY=sk-xxxx
MODEL_BASE_URL=https://api.deepseek.com

# DeepSeek 思考模式（默认关闭）
# deepseek-flash 支持思考 / 非思考两种模式，开启后思考强度由 reasoning_effort 控制：
#   low（省钱快速）/ high（默认）/ max（最深入）
# 注意：开启思考且请求带 tools 时，历史轮次的 reasoning_content 必须原样回传，
# 否则 DeepSeek API 会返回 400。本仓库的 Agent 循环目前不会回传，属实验性用法。
# DEEPSEEK_THINKING=true
# DEEPSEEK_REASONING_EFFORT=high

# 最大 tokens
MAX_TOKENS=16000

# 模型温度（DeepSeek 思考模式下该参数会被忽略）
MODEL_TEMPERATURE=1.0

# 权限模式 (default, acceptEdits, bypassPermissions)
PERMISSION_MODE=bypassPermissions

# ---------------------------------------------------------------------------
# 可选：Anthropic（含 Anthropic 兼容代理）
# ---------------------------------------------------------------------------
# 通用变量写法：
# MODEL_PROVIDER=anthropic
# MODEL_NAME=claude-sonnet-4-5-20250929
# MODEL_API_KEY=sk-xxxx
# MODEL_BASE_URL=https://api.jiekou.ai/anthropic
#
# 兼容旧变量写法（二选一）：
# ANTHROPIC_AUTH_TOKEN=sk_xxxx
# ANTHROPIC_BASE_URL=https://api.jiekou.ai/anthropic
# CLAUDE_MODEL=claude-opus-4-5-20251101

# ---------------------------------------------------------------------------
# 可选：OpenAI / OpenAI-compatible（如接口AI）
# ---------------------------------------------------------------------------
# MODEL_PROVIDER=openai
# MODEL_NAME=gpt-5.4
# MODEL_API_KEY=sk-xxxx
# MODEL_BASE_URL=https://api.jiekou.ai/openai
# OPENAI_REASONING_EFFORT=medium
#
# OpenAI thinking 默认会走 Responses API，并自动将
# https://api.jiekou.ai/openai 规范为 https://api.jiekou.ai/openai/v1
# 如需强制退回 chat/completions，可显式设置：
# OPENAI_USE_RESPONSES_API=false
# chat/completions 模式也会将 https://api.jiekou.ai/openai
# 或误填的 https://api.jiekou.ai/openai/v1/chat/completions
# 规范为 SDK 需要的 https://api.jiekou.ai/openai/v1
#
# 或者使用 OpenAI 专属变量：
# OPENAI_API_KEY=sk_xxxx
# OPENAI_BASE_URL=https://api.jiekou.ai/openai
# OPENAI_MODEL=gpt-5.4

# ---------------------------------------------------------------------------
# 中间件（middleware）
# ---------------------------------------------------------------------------

# 工具调用人工审批（HumanInTheLoopMiddleware），默认开启。
# 拦截 bash / write_file 两类工具：
#   - 交互式 CLI：暂停并询问 批准(a) / 拒绝(r) / 修改参数(e)
#   - Web：/api/chat/stream 返回 interrupt 事件，再 POST /api/chat/resume 提交决策
# 自动化脚本里可设为 false 关闭。
SKILLS_HITL=true

# 上下文自动摘要（SummarizationMiddleware）。
# 历史消息超过该 token 数时，用独立的摘要模型把旧消息压缩成摘要。
# 设为 0 关闭摘要。
SKILLS_SUMMARY_TRIGGER_TOKENS=8000

# 摘要后保留的最近消息条数
SKILLS_SUMMARY_KEEP_MESSAGES=20

# ---------------------------------------------------------------------------
# 意图路由（任务型才结构化输出）
# ---------------------------------------------------------------------------

# 是否开启意图路由（默认开启）。
# 开启后：先关键词快判，再让小模型分类；任务型请求最后用 AgentReply 结构化交卷，
# 聊天型请求关闭 response_format，保持自然对话。
# 设为 false 则一律按聊天型处理（不启用结构化输出）。
SKILLS_INTENT_ROUTER=true

# 意图分类使用的模型名（可选）。
# 默认复用 MODEL_NAME；可换成更便宜的模型以降低分类成本。
# SKILLS_CLASSIFIER_MODEL=deepseek-flash

# ---------------------------------------------------------------------------
# 长期记忆（跨会话）
# ---------------------------------------------------------------------------

# 长期记忆归属的用户 ID。记忆按 ("memories", user_id) 分区，不同用户互相隔离。
# 生产环境应改成登录用户 ID；本仓库默认单用户。
SKILLS_MEMORY_USER=local-user

# ---------------------------------------------------------------------------
# RAG 知识库
# ---------------------------------------------------------------------------
# 原始资料目录（进 git），支持 .md / .markdown / .txt / .pdf
RAG_DOCS_DIR=knowledge
# 切分参数：chunk_size=500 字符，overlap=100 字符（约 20%）
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
# 向量索引：存储在 Chroma 服务的数据目录里（docker-compose.yml 挂载 .rag/chroma，
# 删目录即可重建，已在 .gitignore）。RAG_INDEX_DIR 仅用于文档说明/排查。
RAG_INDEX_DIR=.rag/chroma
RAG_COLLECTION=knowledge

# Chroma 服务地址（第③步使用）
# 本机用 docker compose up -d chroma 启动，默认映射 127.0.0.1:8100。
RAG_CHROMA_HOST=127.0.0.1
RAG_CHROMA_PORT=8100
# 如果 Chroma 走 HTTPS（例如托管服务），设为 true
RAG_CHROMA_SSL=false

# 智谱 Embedding（第③步使用）
# 1) 到 https://bigmodel.cn 控制台创建 API Key
# 2) 把 Key 填到下面的 ZHIPU_API_KEY（只改 .env，不改 .env.example）
# embedding-3 支持 256-2048 维（默认 2048）；换模型或维度必须重建索引。
# ZHIPU_API_KEY=xxxx
RAG_EMBEDDING_MODEL=embedding-3
RAG_EMBEDDING_DIMENSIONS=1024

# 低相关度兜底：本轮最高检索分低于该阈值时，回答末尾追加"可能未覆盖"提示
# （阈值依赖 embedding 模型与语料，换模型后建议用 evals 重新校准）
RAG_LOW_RELEVANCE_SCORE=0.5

# ---------------------------------------------------------------------------
# MCP Server（把 search_docs 暴露给 Claude Code / Cursor / Codex 等外部客户端）
# ---------------------------------------------------------------------------
# stdio 模式不需要下面这些变量（由客户端配置里指定启动命令）。
# HTTP 模式（uv run python scripts/mcp_server.py --http）使用：
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8101
MCP_HTTP_PATH=/mcp
# 调试日志写 stderr（由客户端的启动命令里加 --debug 或设 MCP_DEBUG=1）
# MCP_DEBUG=1

